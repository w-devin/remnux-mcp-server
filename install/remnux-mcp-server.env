# Runtime configuration for remnux-mcp.service.
# This template is copied to /etc/remnux-mcp-server/remnux-mcp-server.env
# by install/install.bash on first installation. Do not commit a production token.
#
# Generate a value with, for example:
#   openssl rand -hex 32
MCP_TOKEN=change-this-before-exposing-the-service
